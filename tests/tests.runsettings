<?xml version="1.0" encoding="utf-8"?>
<!--
  Окружение процессов тестов (подключено в LastEdict.Data.Tests и LastEdict.Rules.Tests свойством RunSettingsFilePath). Только скорость, исходов не меняет
  (выводы всех тестов в trx до и после совпали строка в строку):
  * DOTNET_TieredPGO=0 — без инструментирования PGO: процессы тестов короткие (~1,5 мин), профиль не окупается.
  Замер 21.10 (полный прогон, поочерёдно, вместе с порядком классов tests/Shared/LongestFirst.cs): 97 с, 2471 с процессора, пик 11,0 ГБ →
  81–85 с, 1823–1859 с, пик 9,9–10,5 ГБ. Больший бюджет нулевого поколения (DOTNET_GCgen0size 64/256 МБ) давал ещё −8…10 с, но пик
  13–15 ГБ — не взят: два прогона разом снова не влезли бы в 32 ГБ (docs/perf-log.md, «Скорость проверок, Э1»).
  * DOTNET_GCHeapCount=0x10 (16 куч серверного сборщика на процесс, значение — шестнадцатеричное): два процесса тестов идут разом, и
  каждый со сборщиком на все 32 потока мешал другому — по отдельности LastEdict.Data.Tests 47 с, LastEdict.Rules.Tests 41 с, вместе 80 с. Замер 22.10,
  чередованием: 78–80 с, 1560–1630 с процессора → 64–66 с, 1310–1430 с; пик 9,8–10,9 → 11–12 ГБ (docs/perf-log.md, «Э2 — сборщик»).
  Потолок потоков xUnit (16, 24) поверх — не взят: 70 и 62 с при пике до 13 ГБ, в шуме машины.
-->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <DOTNET_TieredPGO>0</DOTNET_TieredPGO>
      <DOTNET_GCHeapCount>0x10</DOTNET_GCHeapCount>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
