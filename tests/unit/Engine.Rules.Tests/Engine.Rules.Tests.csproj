<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../../tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <!-- Классы тестов — долгие первыми (tests/Shared/LongestFirst.cs, время — tests/test-durations.json). -->
    <Compile Include="../../Shared/LongestFirst.cs" Link="Shared/LongestFirst.cs" />
    <Compile Include="../../Shared/ImportedData.cs" Link="Shared/ImportedData.cs" />
    <Compile Include="../../Shared/RepoPaths.cs" Link="Shared/RepoPaths.cs" />
    <!-- Правила из импорта (tests/Shared/ImportedData.cs): содержимое base и таблицы в JSON порта. -->
    <None Include="../../../data/rules/**" Link="data/rules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../data/content/**" Link="data/content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../test-durations.json" Link="test-durations.json" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="Xunit.TestCollectionOrdererAttribute">
      <_Parameter1>LastEdict.Tests.LongestFirst</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="LastEdict.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Engine.Rules\Engine.Rules.csproj" />
    <ProjectReference Include="..\..\..\src\Engine.Play\Engine.Play.csproj" />
    <ProjectReference Include="..\..\..\src\Game.UiModel\Game.UiModel.csproj" />
  </ItemGroup>

</Project>
